@base = http://localhost:5100
POST {{base}}/auth/register
Content-Type: application/json

{"email":"student@example.com","password":"ChooseYourOwn_Strong123!"}
### Login: copy accessToken from response into token below
POST {{base}}/auth/login?useCookies=false
Content-Type: application/json

{"email":"student@example.com","password":"ChooseYourOwn_Strong123!"}
### Replace placeholder locally, never publish your token
@token = PASTE_ACCESS_TOKEN_HERE
GET {{base}}/api/students?page=1&pageSize=5&search=Lefa
Authorization: Bearer {{token}}
### Create
POST {{base}}/api/students
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"Lefa","age":22}
### Copy the actual version from GET/POST into this body before PUT
PUT {{base}}/api/students/1
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"Lefa Updated","age":23,"version":"PASTE_VERSION_FROM_GET"}
### Delete
DELETE {{base}}/api/students/1
Authorization: Bearer {{token}}

### Partial update: copy a fresh actual version from GET first
PATCH {{base}}/api/students/1
Authorization: Bearer {{token}}
Content-Type: application/json

{"age":24,"version":"PASTE_VERSION_FROM_GET"}
