{
  "name": "lefa-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Static portfolio and StudyLab learning workspace",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"dist/**/*.{html,css,js,mjs}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"*.md\" \"docs/**/*.md\" package.json",
    "format:check": "prettier --check \"dist/**/*.{html,css,js,mjs}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"*.md\" \"docs/**/*.md\" package.json"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
